# =============================================================================
# ComfyUI Docker — Environment Configuration
# =============================================================================

# Host path to your models directory. This is mounted into the container
# at /comfyui/models. The directory structure should match ComfyUI's expected
# layout (checkpoints/, loras/, vae/, controlnet/, etc.).
MODELS_PATH=./models

# Host paths for output and input (created automatically if they don't exist)
OUTPUT_PATH=./output
INPUT_PATH=./input

# Host path for custom nodes (persists Manager-installed nodes)
CUSTOM_NODES_PATH=./custom_nodes

# Port exposed on the host
COMFYUI_PORT=8188

# ComfyUI version (git tag or branch)
COMFYUI_REF=v0.16.3
