# GPU-specific build configuration for NVIDIA RTX 5090 / Blackwell (SM_120)
# Blackwell requires PyTorch NIGHTLY — stable PyTorch does not ship sm_120 kernels.
# Using devel image for full cuBLAS support (runtime causes CUBLAS errors).
# CUDA 12.8.1 chosen for broad RunPod driver compatibility (13.x may exceed host driver).
CUDA_VERSION=12.8.1
#CUDA_VARIANT=devel
TORCH_CUDA=cu128
#TORCH_CHANNEL=nightly
GPU_TAG=rtx5090
