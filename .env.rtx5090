# GPU-specific build configuration for NVIDIA RTX 5090 / Blackwell (SM_120)
# Using devel image for full cuBLAS support (runtime causes CUBLAS errors).
# CUDA 12.8.1 chosen for broad RunPod driver compatibility (13.x may exceed
# host driver) and because Nunchaku ships cu12.8 wheels for this stack.
CUDA_VERSION=12.8.1
#CUDA_VARIANT=devel
TORCH_CUDA=cu128

# Torch: pinned to 2.11.0 stable. Stable PyTorch ships sm_120 (Blackwell)
# kernels since 2.7, so nightly is no longer required. The exact pin is
# needed because Nunchaku wheels are built against a specific torch minor.
#TORCH_CHANNEL=stable
TORCH_VERSION=2.11.0

# Nunchaku (SVDQuant 4-bit inference engine) — enabled for Blackwell.
INSTALL_NUNCHAKU=true
NUNCHAKU_VERSION=1.2.1

# Skip baking custom-node deps into the image (installed on first boot
# instead) — keeps 5090 image builds fast while the node set is in flux.
INSTALL_NODE_DEPS=false

GPU_TAG=rtx5090
